# Copy this file to .env (cp .env.example .env), then change the passwords.
# Never share or commit your real .env file.

# Change these
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-database-password
# Don't change these
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
NEXTCLOUD_ADMIN_USER=admin
# Change this
NEXTCLOUD_ADMIN_PASSWORD=change-me-admin-password
